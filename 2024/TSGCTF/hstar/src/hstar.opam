opam-version: "2.0"
name: "hstar"
version: "0.1.0"
synopsis: "H*: a refinement type system for Haskell"
description: "H*: a refinement type system for Haskell"
license: "MIT"
depends: [
  "ocaml" {>= "4.14.0"}
  "dune" {>= "3.0"}
  "core" {>= "0.15"}
  "core_unix" {>= "0.15"}
  "menhir" {>= "20200123"}
  "menhirLib" {>= "20200123"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
